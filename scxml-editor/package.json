{
  "name": "scxml-editor",
  "displayName": "SCXML State Chart Editor",
  "description": "SCXML validation and state-chart visualization for Visual Studio Code.",
  "version": "0.1.0",
  "engines": { "vscode": "^1.100.0" },
  "categories": ["Programming Languages", "Visualization"],
  "activationEvents": ["onLanguage:scxml", "onCustomEditor:scxml.stateChart", "onCommand:scxml.createDocument"],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [{
      "id": "scxml",
      "aliases": ["SCXML", "scxml"],
      "extensions": [".scxml"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "scxml",
      "scopeName": "text.xml.scxml",
      "path": "./syntaxes/scxml.tmLanguage.json"
    }],
    "commands": [
      { "command": "scxml.createDocument", "title": "SCXML: Create State Chart" },
      { "command": "scxml.openDiagram", "title": "SCXML: Open State Chart Diagram" }
    ],
    "menus": {
      "editor/title": [{
        "command": "scxml.openDiagram",
        "when": "resourceExtname == .scxml",
        "group": "navigation"
      }]
    },
    "customEditors": [{
      "viewType": "scxml.stateChart",
      "displayName": "SCXML State Chart",
      "selector": [{ "filenamePattern": "*.scxml" }],
      "priority": "option"
    }]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack --mode development",
    "watch": "webpack --mode development --watch",
    "package": "webpack --mode production",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "dependencies": {
    "fast-xml-parser": "^5.2.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.100.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "eslint": "^9.0.0",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.0",
    "webpack": "^5.99.0",
    "webpack-cli": "^6.0.0"
  }
}
