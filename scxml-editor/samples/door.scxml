<?xml version="1.0" encoding="UTF-8"?>
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" name="DoorController">
  <initial>
    <transition target="closed"/>
  </initial>
  <state id="closed">
        <onentry>
      <log label="label" expr="expression"/>
            <raise event="event.name"/>
      <foreach array="items" item="item" index="index">
        <log label="item" expr="item"/>
      </foreach>
    </onentry>
    <transition event="e4" target="s3"/>
    <transition event="e2" target="staate2"/><transition event="open" target="opened"/>
    <onexit>
      <assign location="variable" expr="5"/>
    </onexit>
  </state>
  <state id="opened"><transition event="close" target="closed"/></state>

  <state id="staate2" initial="ss5">
    <transition event="e3" target="s3"/>
  
  
  
  
    <state id="ss5"/>
  </state>

  <parallel id="s3">
  
  
  
  
  
  
  
  
  
  
  
  
  
    <state id="ss3" initial="sss7">
    <transition event="evs5" target="ss6"/>
    
    
                  <state id="sss7">
              <transition event="ev67" cond="canDoIt()" target="ss6"/>
            </state>
    </state>
  
    <state id="ss3par"/>
  
    <state id="ss45"/>
  
  
    <invoke id="service" type="scxml" src="child.scxml" autoforward="false">
      <param name="input"/>
      <finalize>
        <assign location="result" expr="_event.data"/>
      </finalize>
    </invoke>
  </parallel>



  <parallel id="ss6">
    <transition event="final1" target="f1"/>
    
    <state id="ss6_p1"/>
  
    <state id="ss6_p2"/>
  </parallel>
  <state id="t61">
    <onentry>
      <send event="event.name" target="#_internal" delay="1s" id="sendId"/>
    </onentry>
    <transition event="t1t" cond="isOk()" target="s3"/>
      <state id="t7"/>
  
    <history id="h1" type="shallow"></history>
  
    <onexit>
      <cancel sendid="sendId"/>
    </onexit>
  </state>

  <parallel id="Par12">
    <state id="par12_sub1"/>
  
    <state id="par12_sub2"/>
  </parallel>

  <final id="f1"/>

</scxml>
